"uart_communication\stm32f1xx_hal_rcc_ex.o"
"uart_communication\stm32f1xx_hal_gpio.o"
"uart_communication\stm32f1xx_hal_dma.o"
"uart_communication\stm32f1xx_hal_cortex.o"
"uart_communication\stm32f1xx_hal_pwr.o"
